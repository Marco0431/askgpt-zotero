{
  "name": "askgpt",
  "type": "module",
  "version": "1.2.6",
  "description": "选中文献文字，按 Ctrl+K 弹出小窗向 AI 提问。支持 PDF、HTML、Markdown 附件全文提问。兼容 DeepSeek 及任意 OpenAI 兼容 API。",
  "config": {
    "addonName": "AskGPT - Zotero AI 阅读助手",
    "addonID": "askgpt@askgpt.zotero",
    "addonRef": "askgpt",
    "addonInstance": "AskGPT",
    "prefsPrefix": "extensions.askgpt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marco0431/askgpt-zotero.git"
  },
  "author": "Marco",
  "bugs": {
    "url": "https://github.com/Marco0431/askgpt-zotero/issues"
  },
  "homepage": "https://github.com/Marco0431/askgpt-zotero#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
